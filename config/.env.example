# Topaz US 环境配置

# Slack Bot Token（用于发送分析报告）
# 获取方式：Slack App → OAuth & Permissions → Bot User OAuth Token
# 格式: xoxb-xxxxxxxxxx-xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Slack 目标频道（频道名或用户 ID）
# 发送到频道: #investments
# 发送到 DM: UXXXXXXXXX（用户ID）
SLACK_CHANNEL=

# Optional yfinance proxy. Useful when Yahoo Finance rate-limits direct traffic.
# Clash/Mihomo/Verge mixed ports often look like: http://127.0.0.1:7897
TOPAZ_YF_PROXY=
